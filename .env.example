# Backend identity and network
APP_NAME=Konvertira
APP_VERSION=3.0.0
PORT=8000
PUBLIC_BASE_URL=https://api.konvertira.com

# Replace with a long random value. Used only by legacy protected routes.
API_KEY=replace-with-a-long-random-secret

# Processing limits and temporary storage
MAX_IMAGE_SIZE=20971520
MAX_IMAGE_OUTPUT_SIZE=104857600
MAX_PIXELS=100000000
IMAGE_TARGET_SIZE_ATTEMPTS=7
MAX_PDF_SIZE=41943040
MAX_PDF_FILES=10
MAX_PDF_TOTAL_SIZE=104857600
MAX_PDF_OUTPUT_SIZE=104857600
MAX_PDF_PAGES=250
MAX_PDF_RASTER_DPI=200
MAX_PDF_GENERATED_PIXELS=100000000
MAX_DOCUMENT_SIZE=26214400
MAX_DOCUMENT_OUTPUT_SIZE=104857600
DOCUMENT_JOB_TIMEOUT_SECONDS=60
LIBREOFFICE_PATH=libreoffice
MAX_ARCHIVE_ENTRIES=5000
MAX_ARCHIVE_UNCOMPRESSED_BYTES=209715200
MAX_TEMP_STORAGE_BYTES=1073741824
RESULT_TTL_SECONDS=900
STORAGE_DIR=/tmp/konvertira-results
MCP_STORAGE_DIR=/tmp/konvertira-mcp-results

# Comma-separated allowlists
ALLOWED_DOWNLOAD_HOSTS=openai.com,oaiusercontent.com
CORS_ORIGINS=http://localhost:5173,http://localhost:8080,https://konvertira.com

# In-memory request protection (limits apply per application process)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=30
RATE_LIMIT_HEAVY_JOBS_PER_MINUTE=5
MAX_CONCURRENT_HEAVY_JOBS_PER_IP=2
MAX_CONCURRENT_HEAVY_JOBS_GLOBAL=2

# Trust forwarding headers only when the immediate peer matches one of these
# IPs/CIDRs. Add the exact Caddy/container-network peer range in production.
TRUSTED_PROXY_IPS=127.0.0.1/32,::1/128

# MCP transport
MCP_PORT=8001
MCP_PUBLIC_BASE_URL=https://mcp.konvertira.com
MCP_ALLOWED_HOSTS=mcp.konvertira.com,localhost:8001
MCP_ALLOWED_ORIGINS=https://chatgpt.com,https://www.chatgpt.com

# MCP / ChatGPT global protection. Disabling the rate limiter does not disable
# concurrency, timeout, file-size, pixel, or temporary-storage safeguards.
MCP_RATE_LIMIT_ENABLED=true
MCP_RATE_LIMIT_PER_MINUTE=30
MCP_HEAVY_JOBS_PER_MINUTE=10
MCP_MAX_GLOBAL_JOBS=2
MCP_JOB_TIMEOUT_SECONDS=60
MCP_MAX_TEMP_STORAGE_MB=512
