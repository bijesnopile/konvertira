# Backend identity and network
APP_NAME=Image Privacy Protector
APP_VERSION=3.0.0
PORT=8000
PUBLIC_BASE_URL=https://api.konvertira.com

# Replace with a long random value. Used only by legacy protected routes.
API_KEY=replace-with-a-long-random-secret

# Processing limits and temporary storage
MAX_IMAGE_SIZE=20971520
MAX_PIXELS=100000000
RESULT_TTL_SECONDS=900
STORAGE_DIR=/tmp/konvertira-results
MCP_STORAGE_DIR=/tmp/konvertira-mcp-results

# Comma-separated allowlists
ALLOWED_DOWNLOAD_HOSTS=openai.com,oaiusercontent.com
CORS_ORIGINS=http://localhost:5173,http://localhost:8080,https://konvertira.com

# MCP transport
MCP_PORT=8001
MCP_PUBLIC_BASE_URL=https://mcp.konvertira.com
MCP_ALLOWED_HOSTS=mcp.konvertira.com,localhost:8001
MCP_ALLOWED_ORIGINS=https://chatgpt.com,https://www.chatgpt.com
